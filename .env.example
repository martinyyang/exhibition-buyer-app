# Supabase项目配置
# 复制此文件为 .env 并填入实际值

# Supabase项目URL（直连，海外使用）
SUPABASE_URL=https://your-project-ref.supabase.co

# Cloudflare Workers 代理URL（可选，中国使用）
# 配置后会优先使用代理访问，提升中国网络环境下的连接速度
# 格式：https://your-worker-name.your-subdomain.workers.dev
# 留空或注释掉则使用直连 SUPABASE_URL
SUPABASE_PROXY_URL=

# Supabase匿名公钥（anon key）
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase服务密钥（仅服务端使用，不要提交到代码仓库）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 数据库直连字符串（用于迁移）
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
